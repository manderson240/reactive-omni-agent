# ==============================================================================
# Reactive Sentinel Environment Configuration Template
# Sensitive Network IDs, Endpoints & Credentials
#
# IMPORTANT SECURITY POLICY:
# Store these sensitive credentials in Google Password Manager.
# Do NOT commit active chain IDs, private keys, or endpoints to version control.
# Copy this file to .env and export before running live deployment or monitoring.
# ==============================================================================

# Deployer / Operator Private Key
export PRIVATE_KEY="your_private_key_from_password_manager"

# Sensitive Network Chain IDs (Stored in Google Password Manager)
export ORIGIN_CHAIN_ID="84532"           # Base Sepolia
export DESTINATION_CHAIN_ID="84532"      # Base Sepolia
export REACTIVE_CHAIN_ID="5318007"       # Reactive Lasna Testnet

# RPC Endpoints
export BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
export REACTIVE_LASNA_RPC_URL="https://lasna-rpc.rnk.dev"

# Contract Deployment Addresses (Set after deployment)
export ORIGIN_CONTRACT=""
export DESTINATION_CONTRACT=""
export REACTIVE_CONTRACT=""
export CALLBACK_RELAYER=""

# Sentinel Node Configuration
export SENTINEL_AGENT_ID="sentinel-lasna-01"
